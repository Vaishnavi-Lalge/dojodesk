# Copy to .env for local development. NEVER commit the real .env file.

# development | production
APP_ENV=development

# Long random string. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. In development a random one is generated per start.
SECRET_KEY=

# --- Database (choose ONE style) ---
# A) Connection string. Special characters in the password MUST be URL-encoded
#    (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25, ? -> %3F).
#    Render needs the Supabase *pooler* string (Connect > Transaction pooler, port 6543).
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# B) Separate parts (no URL-encoding needed). Used only when DATABASE_URL is empty.
# DB_HOST=
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.YOURPROJECTREF
# DB_PASSWORD=
# require for Supabase; use "disable" for a local PostgreSQL without SSL
DB_SSLMODE=require

# --- Optional ---
DOJO_NAME=DojoDesk Karate Dojo
CURRENCY_SYMBOL=₹
TIMEZONE=Asia/Kolkata

# First admin without shell access (e.g. Render free tier). Applied by `flask db-upgrade`
# only when no admin exists yet. Generate the hash locally: flask --app app hash-password
# ADMIN_USERNAME=admin
# ADMIN_FULL_NAME=Head Instructor
# ADMIN_PASSWORD_HASH='scrypt:...'
